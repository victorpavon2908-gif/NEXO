<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexo" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/nexo_splash_background</item>
        <item name="android:windowBackground">@color/nexo_splash_background</item>
        <item name="android:colorAccent">@color/nexo_cyan</item>
        <item name="android:windowSplashScreenBackground">@color/nexo_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_nexo_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/nexo_launcher_background</item>
    </style>
</resources>
